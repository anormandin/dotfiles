-- Generated by `theme` from $slug — do not edit by hand
return {
	force_reverse_video_cursor = true,
	font = "$font",
	gradient = { "$g1", "$g2", "$g3" },
	colors = {
		foreground = "$fg",
		background = "$term",

		cursor_bg = "$fg",
		cursor_fg = "$fg",
		cursor_border = "$fg",

		selection_fg = "$fg",
		selection_bg = "$sel",

		scrollbar_thumb = "$wall",
		split = "$wall",

		ansi = { "$ansi0", "$ansi1", "$ansi2", "$ansi3", "$ansi4", "$ansi5", "$ansi6", "$ansi7" },
		brights = { "$ansi8", "$ansi9", "$ansi10", "$ansi11", "$ansi12", "$ansi13", "$ansi14", "$ansi15" },
		indexed = { [16] = "$orange", [17] = "$red" },
	},
}
