# Generated by `theme` from $slug — do not edit by hand
# Loaded via LG_CONFIG_FILE alongside the main lazygit config
gui:
  theme:
    activeBorderColor: ["$accent", "bold"]
    inactiveBorderColor: ["$dim"]
    searchingActiveBorderColor: ["$yellow", "bold"]
    optionsTextColor: ["$accent"]
    selectedLineBgColor: ["$sel"]
    cherryPickedCommitFgColor: ["$cyan"]
    cherryPickedCommitBgColor: ["$magenta"]
    markedBaseCommitFgColor: ["$accent"]
    markedBaseCommitBgColor: ["$yellow"]
    unstagedChangesColor: ["$red"]
    defaultFgColor: ["$fg"]
