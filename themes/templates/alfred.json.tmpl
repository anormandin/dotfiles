{
  "alfredtheme" : {
    "name" : "$name (rice)",
    "credit" : "theme CLI (dotfiles)",
    "window" : {
      "color" : "${term}FF",
      "roundness" : 12,
      "paddingHorizontal" : 10,
      "paddingVertical" : 10,
      "borderPadding" : 0,
      "borderColor" : "${accent}66",
      "blur" : 0,
      "width" : 640
    },
    "search" : {
      "background" : "${wall}FF",
      "backgroundSelected" : "${sel}FF",
      "roundness" : 8,
      "paddingHorizontal" : 12,
      "paddingVertical" : 8,
      "spacing" : 10,
      "text" : {
        "font" : "$font",
        "size" : 26,
        "color" : "${fg}FF",
        "colorSelected" : "${fg}FF"
      }
    },
    "result" : {
      "backgroundSelected" : "${sel}FF",
      "roundness" : 8,
      "paddingVertical" : 9,
      "iconSize" : 36,
      "iconPaddingHorizontal" : 6,
      "textSpacing" : 8,
      "text" : {
        "font" : "$font",
        "size" : 17,
        "color" : "${fg}FF",
        "colorSelected" : "${fg}FF"
      },
      "subtext" : {
        "font" : "$font",
        "size" : 11,
        "color" : "${dim}FF",
        "colorSelected" : "${dim}FF"
      },
      "shortcut" : {
        "font" : "$font",
        "size" : 14,
        "color" : "${dim}FF",
        "colorSelected" : "${accent}FF"
      }
    },
    "separator" : {
      "color" : "${dim}33",
      "thickness" : 1
    },
    "scrollbar" : {
      "color" : "${accent}99",
      "thickness" : 2
    }
  }
}
