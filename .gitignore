# --- zsh runtime / generated files (not config) ---
home/.config/zsh/.zcompdump*
home/.config/zsh/.zsh_history

# Auto-cloned by plugins.zsh on first shell startup; reproducible, don't track
home/.config/zsh/plugins/

# --- tmux: TPM-managed plugins & resurrect/continuum state (reproducible) ---
home/.config/tmux/plugins/
home/.config/tmux/resurrect/

# --- machine-local Claude settings (any package) ---
**/.claude/settings.local.json

# --- JetBrains IDE workspace files (not config) ---
**/.idea/

# --- editor/config backup files ---
*.bak

# --- emacs installed packages & generated/backup files (reproducible) ---
home/.config/emacs/elpa/
home/.config/emacs/eln-cache/
home/.config/emacs/auto-save-list/
home/.config/emacs/transient/
home/.config/emacs/*~
home/.config/emacs/\#*\#
# Hyprland 0.55 autoregenerates this stub even when using hyprland.lua
home/.config/hypr/hyprland.conf
# --- doom emacs user config (~/.config/doom): track init/config/packages.el,
#     ignore generated/backup files. Doom's framework + packages live in
#     ~/.config/emacs (its own git clone), outside this repo. ---
home/.config/doom/.local/
home/.config/doom/eln-cache/
home/.config/doom/auto-save-list/
home/.config/doom/transient/
home/.config/doom/*~
home/.config/doom/\#*\#
